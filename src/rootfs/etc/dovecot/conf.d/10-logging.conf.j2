# Logging configuration
# https://doc.dovecot.org/2.4.2/core/logging/
log_path = syslog

auth_verbose = yes

{% if environ('DOVECOT_DEBUG') == 'yes' %}
log_debug = category=auth category=mail
{% endif %}

# Log mail events (delete, expunge, save, copy, mailbox operations, flag changes)
# Useful for auditing and debugging delivery/IMAP issues
# https://doc.dovecot.org/2.4.2/core/plugins/mail_log.html
mail_plugins {
  mail_log = yes
  notify = yes
}

mail_log_events = delete undelete expunge save copy mailbox_create mailbox_delete mailbox_rename flag_change

