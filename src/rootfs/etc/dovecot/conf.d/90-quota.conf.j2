# Quota plugin configuration
# https://doc.dovecot.org/2.4.2/core/plugins/quota.html

# Per-user quota is set by the quota_storage_size extra field from userdb
# (CONCAT(quota_bytes, 'M') AS quota_storage_size in dovecot-sql.conf.ext.j2).

# Quota driver: count is the recommended driver as of 2.4 (tracks quota in
# Dovecot's index files; requires mailbox_list_index = yes for performance)
# https://doc.dovecot.org/2.4.2/core/plugins/quota/backends/count/
quota_driver = count

# Allow delivery to temporarily exceed quota by up to 10 MB before rejecting
# (size, not percentage — default is also 10M)
quota_storage_grace = 10M

# Quota warnings — executed when usage crosses a threshold
# https://doc.dovecot.org/2.4.2/core/plugins/quota/warnings/
quota "User quota" {
  warning warn-95 {
    quota_storage_percentage = 95
    execute quota-warning {
      args = 95 %{user}
    }
  }
  warning warn-80 {
    quota_storage_percentage = 80
    execute quota-warning {
      args = 80 %{user}
    }
  }
}

service quota-warning {
  executable = script /usr/local/bin/quota-warning.sh
  user = vmail
  group = vmail

  unix_listener quota-warning {
    user = vmail
    group = vmail
  }
}

# Quota status: Postfix policy daemon — rejects over-quota mail at SMTP level
# https://doc.dovecot.org/2.4.2/core/plugins/quota/quota_status/
quota_status_success = DUNNO
quota_status_nouser = DUNNO
quota_status_overquota = "452 4.2.2 The email account that you tried to reach is over quota."

service quota-status {
  executable = quota-status -p postfix
  client_limit = 1

  inet_listener postfix {
    port = 12340
  }
}
