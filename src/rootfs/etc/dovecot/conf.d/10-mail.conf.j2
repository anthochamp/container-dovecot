# SSL/TLS — require encrypted connections
# All SSL settings are here (rendered at runtime by the entrypoint) so that
# doveconf does not validate cert paths at image build time (certs are
# volume-mounted; /etc/dovecot/tls/ is empty during the build).
# https://doc.dovecot.org/2.4.2/core/config/ssl.html
ssl = required
ssl_server_cert_file = /etc/dovecot/tls/fullchain.pem
ssl_server_key_file = /etc/dovecot/tls/key.pem
ssl_server_prefer_ciphers = client

# Mail storage location
# mail_driver, mail_uid, mail_gid are set in dovecot.conf
# https://doc.dovecot.org/2.4.2/core/config/mail_location.html
mail_path = ~/Maildir
mail_home = /var/vmail/%{user}

# Keep mailbox list index for fast quota calculations (required for count driver)
# https://doc.dovecot.org/2.4.2/core/plugins/quota/backends/count/
mailbox_list_index = yes

# IMAP METADATA admin contact URI (RFC 5464)
# https://doc.dovecot.org/2.4.2/core/config/settings/mail_server_admin/
mail_server_admin = mailto:{{ environ('DOVECOT_ADMIN_EMAIL') }}

# Global plugins (per-protocol plugins are in the protocol blocks below)
mail_plugins {
  quota = yes
  virtual = yes
}

# Inbox namespace and IMAP special-use mailboxes (RFC 6154)
# https://doc.dovecot.org/2.4.2/core/config/namespaces.html
# https://doc.dovecot.org/2.4.2/core/config/mailbox_settings.html
namespace inbox {
  separator = /
  inbox = yes

  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Junk {
    auto = create
    special_use = \Junk
    autoexpunge = 30d
  }
  mailbox Trash {
    auto = create
    special_use = \Trash
    autoexpunge = 30d
  }
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox "Sent Messages" {
    special_use = \Sent
  }
  mailbox virtual/All {
    auto = subscribe
    special_use = \All
  }
  mailbox virtual/Flagged {
    special_use = \Flagged
  }
  mailbox virtual/Important {
    special_use = \Important
  }
  mailbox Archive {
    auto = subscribe
    special_use = \Archive
  }
}

# Virtual namespace for aggregated mailboxes (All/Flagged/Important)
# https://doc.dovecot.org/2.4.2/core/plugins/virtual.html
namespace virtual {
  prefix = virtual/
  separator = /
  mail_driver = virtual
  # Global dovecot-virtual definition files (shared, read-only)
  mail_path = /etc/dovecot/virtual
  # Per-user indexes, control and volatile state
  mail_index_path = ~/Virtual
  mail_control_path = ~/Virtual
  mail_volatile_path = ~/Virtual
  # Not a primary namespace; hide from NAMESPACE command and LIST *
  hidden = yes
  list = no
}

# Escape character for mailbox names on disk (replaces the removed listescape plugin)
# https://doc.dovecot.org/2.4.2/installation/upgrade/2.3-to-2.4.html
mailbox_list_storage_escape_char = \\

# Protocol-specific plugin configuration
# https://doc.dovecot.org/2.4.2/core/config/imap.html
protocol imap {
  mail_plugins {
    imap_sieve = yes
    imap_quota = yes
  }
}

# https://doc.dovecot.org/2.4.2/core/config/lmtp.html
protocol lmtp {
  mail_plugins {
    sieve = yes
  }
}

# https://doc.dovecot.org/2.4.2/core/config/lda.html
protocol lda {
  log_path = /var/log/dovecot/dovecot-lda.log
}
